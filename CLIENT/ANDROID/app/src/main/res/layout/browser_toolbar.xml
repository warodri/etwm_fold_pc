<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_toolbar"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <ImageButton
        android:id="@+id/btn_back"
        style="@style/ToolIconButton"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back" />

    <ImageButton
        android:id="@+id/btn_forward"
        style="@style/ToolIconButton"
        android:contentDescription="@string/forward"
        android:src="@drawable/ic_forward" />

    <ImageButton
        android:id="@+id/btn_reload"
        style="@style/ToolIconButton"
        android:contentDescription="@string/reload"
        android:src="@drawable/ic_reload" />

    <LinearLayout
        android:id="@+id/address_container"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:background="@drawable/bg_address"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="7dp">

        <ImageView
            android:id="@+id/site_security_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lock" />

        <EditText
            android:id="@+id/address_bar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="sans-serif"
            android:hint="@string/address_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textCursorDrawable="@null"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btn_clear_address"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_close_button"
            android:contentDescription="@string/close"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text_secondary"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/btn_tabs"
        android:layout_width="38dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_tool_button"
        android:clickable="true"
        android:contentDescription="@string/tabs"
        android:focusable="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tabs"
            android:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tab_count"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="1dp"
            android:background="@drawable/bg_count_badge"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:minWidth="14dp"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:text="1"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btn_keyboard_toggle"
        style="@style/ToolIconButton"
        android:contentDescription="@string/hide_keyboard"
        android:src="@drawable/ic_keyboard_hide" />

    <ImageButton
        android:id="@+id/btn_menu"
        style="@style/ToolIconButton"
        android:contentDescription="@string/menu"
        android:src="@drawable/ic_menu" />
</LinearLayout>
